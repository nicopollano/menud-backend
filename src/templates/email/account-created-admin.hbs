<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Cuenta creada</title>
    <style>
      body { font-family: Arial, sans-serif; background-color: #f4f4f4; margin:
      0; padding: 0; color: #333333; } .container { max-width: 600px; margin: 0
      auto; background-color: #ffffff; padding: 20px; border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); } .header { text-align: center;
      padding-bottom: 20px; border-bottom: 1px solid #dddddd; } .header img {
      max-width: 100px; } .content { padding: 20px 0; } .footer { text-align:
      center; padding-top: 20px; border-top: 1px solid #dddddd; font-size: 12px;
      color: #aaaaaa; }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Bienvenido a Gastronomic</h1>
      </div>
      <div class='content'>
        <p>Hola, {{username}}</p>
        <p>Tu cuenta ha sido creada</p>
        <p>Tu compania "{{branch_name}}" ya se encuentra activa</p>
      </div>
      <div class='footer'>
        <p>Gracias,</p>
        <p>El equipo de Gastronomic</p>
      </div>
    </div>
  </body>
</html>